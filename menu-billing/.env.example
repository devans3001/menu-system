# Paystack test secret key. Paystack dashboard (test mode) > Settings >
# API Keys & Webhooks. Use the TEST secret key for integration testing,
# never the live key in a local file.
PAYSTACK_SECRET_KEY=sk_test_REPLACE_WITH_YOUR_TEST_SECRET_KEY

# Neon connection string. Neon console > your project > Connection string
# (pooled). This must be the SAME database menu-template reads its
# restaurants table from, with menu-template/schema.sql already run.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Owner payment alerts (optional until sending is switched on).
# Without RESEND_API_KEY, alerts are recorded in the notifications
# table with full content instead of being sent. ALERT_FROM_EMAIL
# needs a domain verified in Resend to send to restaurant owners;
# the default onboarding sender can only reach the Resend account's
# own email, which is enough for end-to-end tests.
RESEND_API_KEY=re_REPLACE_WITH_YOUR_RESEND_KEY
ALERT_FROM_EMAIL=Claro & Co <alerts@your-verified-domain>

# Shared secret for the daily billing-alert scan. Vercel Cron sends
# it automatically as a Bearer token when this env var exists.
CRON_SECRET=REPLACE_WITH_A_LONG_RANDOM_STRING
